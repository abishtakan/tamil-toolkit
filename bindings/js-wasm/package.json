{
  "name": "tamil-toolkit",
  "version": "0.1.0-alpha.8",
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "https://github.com/abishtakan/tamil-toolkit.git", "directory": "bindings/js-wasm"},
  "homepage": "https://tamil-toolkit-playground.vercel.app/",
  "bugs": "https://github.com/abishtakan/tamil-toolkit/issues",
  "keywords": ["tamil", "unicode", "webassembly", "wasm", "rust", "agara-varisai", "collation", "number-to-words", "bamini", "tscii", "panchangam", "hyphenation"],
  "engines": {"node": ">=22"},
  "publishConfig": {"access": "public", "tag": "alpha"},
  "type": "module",
  "description": "All-in-one Rust/WebAssembly Tamil linguistic engine for Node.js and browsers: Unicode rules, Agara Varisai sorting, numerals, hyphenation, Panchangam, and legacy codecs.",
  "exports": {
    ".": {
      "node": {"types": "./dist/index.d.ts", "default": "./dist/index.js"},
      "default": {"types": "./dist/web.d.ts", "default": "./dist/web.js"}
    },
    "./web": {"types": "./dist/web.d.ts", "default": "./dist/web.js"}
  },
  "files": ["dist", "pkg-node", "pkg-web", "README.md", "LICENSE", "NOTICE", "THIRD_PARTY_NOTICES.md", "THIRD_PARTY_LICENSES.txt"],
  "scripts": {"build": "tsc", "test": "vitest run"},
  "devDependencies": {"@types/node": "^24.0.0", "typescript": "7.0.2", "vitest": "5.0.5", "wasm-pack": "0.15.1"}
}
