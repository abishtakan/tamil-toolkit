    "text": "\u0b85\u0bae\u0bcd\u0bae\u0bbe"
  },
  {
    "id": "word_004",
    "kind": "word",
    "text": "\u0b85\u0baa\u0bcd\u0baa\u0bbe"
  },
  {
    "id": "word_005",
    "kind": "word",
    "text": "\u0bb5\u0ba3\u0b95\u0bcd\u0b95\u0bae\u0bcd"
  },
  {
    "id": "word_006",
    "kind": "word",
    "text": "\u0b95\u0bc8\u0b95\u0bc2\u0baa\u0bcd\u0baa\u0bbf"
  },
  {
    "id": "word_007",
    "kind": "word",
    "text": "\u0baa\u0bc2 \u0b9a\u0bc2 \u0bb5\u0bc2 \u0baf\u0bc2"
  },
  {
    "id": "word_008",
    "kind": "word",
    "text": "\u0b85, \u0b86!"
  },
  {
    "id": "word_009",
    "kind": "word",
    "text": "\u0b95\u0bcc \u0b95\u0bcb \u0b95\u0bca \u0b95\u0bc8 \u0b95\u0bc7 \u0b95\u0bc6 \u0b95\u0bc2 \u0b95\u0bc1 \u0b95\u0bc0 \u0b95\u0bbf \u0b95\u0bbe \u0b95\u0bcd \u0b95"
  },
  {
    "id": "word_010",
    "kind": "word",
    "text": "\u0b99\u0bcc \u0b99\u0bcb \u0b99\u0bca \u0b99\u0bc8 \u0b99\u0bc7 \u0b99\u0bc6 \u0b99\u0bc0 \u0b99\u0bbf \u0b99\u0bbe \u0b99\u0bcd \u0b99"
  },
  {
    "id": "word_011",
    "kind": "word",
    "text": "\u0b9a\u0bcc \u0b9a\u0bcb \u0b9a\u0bca \u0b9a\u0bc8 \u0b9a\u0bc7 \u0b9a\u0bc6 \u0b9a\u0bc2 \u0b9a\u0bc1 \u0b9a\u0bc0 \u0b9a\u0bbf \u0b9a\u0bbe \u0b9a\u0bcd \u0b9a"
  },
  {
    "id": "word_012",
    "kind": "word",
    "text": "\u0b9c\u0bcc \u0b9c\u0bcb \u0b9c\u0bca \u0b9c\u0bc8 \u0b9c\u0bc7 \u0b9c\u0bc6 \u0b9c\u0bc2 \u0b9c\u0bc1 \u0b9c\u0bc0 \u0b9c\u0bbf \u0b9c\u0bbe \u0b9c\u0bcd \u0b9c"
  },
  {
    "id": "word_013",
    "kind": "word",
    "text": "\u0b9e\u0bcc \u0b9e\u0bcb \u0b9e\u0bca \u0b9e\u0bc8 \u0b9e\u0bc7 \u0b9e\u0bc6 \u0b9e\u0bc0 \u0b9e\u0bbf \u0b9e\u0bbe \u0b9e\u0bcd \u0b9e"
  },
  {
    "id": "word_014",
    "kind": "word",
    "text": "\u0b9f\u0bcc \u0b9f\u0bcb \u0b9f\u0bca \u0b9f\u0bc8 \u0b9f\u0bc7 \u0b9f\u0bc6 \u0b9f\u0bc2 \u0b9f\u0bc1 \u0b9f\u0bc0 \u0b9f\u0bbf \u0b9f\u0bbe \u0b9f\u0bcd \u0b9f"
  },
  {
    "id": "word_015",
    "kind": "word",
    "text": "\u0ba3\u0bcc \u0ba3\u0bcb \u0ba3\u0bca \u0ba3\u0bc8 \u0ba3\u0bc7 \u0ba3\u0bc6 \u0ba3\u0bc2 \u0ba3\u0bc1 \u0ba3\u0bc0 \u0ba3\u0bbf \u0ba3\u0bbe \u0ba3\u0bcd \u0ba3"
  },
  {
    "id": "word_016",
    "kind": "word",
    "text": "\u0ba4\u0bcc \u0ba4\u0bcb \u0ba4\u0bca \u0ba4\u0bc8 \u0ba4\u0bc7 \u0ba4\u0bc6 \u0ba4\u0bc2 \u0ba4\u0bc1 \u0ba4\u0bc0 \u0ba4\u0bbf \u0ba4\u0bbe \u0ba4\u0bcd \u0ba4"
  },
  {
    "id": "word_017",
    "kind": "word",
    "text": "\u0ba8\u0bcc \u0ba8\u0bcb \u0ba8\u0bca \u0ba8\u0bc8 \u0ba8\u0bc7 \u0ba8\u0bc6 \u0ba8\u0bc2 \u0ba8\u0bc1 \u0ba8\u0bc0 \u0ba8\u0bbf \u0ba8\u0bbe \u0ba8\u0bcd \u0ba8"
  },
  {
    "id": "word_018",
    "kind": "word",
    "text": "\u0ba9\u0bcc \u0ba9\u0bcb \u0ba9\u0bca \u0ba9\u0bc8 \u0ba9\u0bc7 \u0ba9\u0bc6 \u0ba9\u0bc2 \u0ba9\u0bc1 \u0ba9\u0bc0 \u0ba9\u0bbf \u0ba9\u0bbe \u0ba9\u0bcd \u0ba9"
  },
  {
    "id": "word_019",
    "kind": "word",
    "text": "\u0baa\u0bcc \u0baa\u0bcb \u0baa\u0bca \u0baa\u0bc8 \u0baa\u0bc7 \u0baa\u0bc6 \u0baa\u0bc2 \u0baa\u0bc1 \u0baa\u0bc0 \u0baa\u0bbf \u0baa\u0bbe \u0baa\u0bcd \u0baa"
  },
  {
    "id": "word_020",
    "kind": "word",
    "text": "\u0bae\u0bcc \u0bae\u0bcb \u0bae\u0bca \u0bae\u0bc8 \u0bae\u0bc7 \u0bae\u0bc6 \u0bae\u0bc2 \u0bae\u0bc1 \u0bae\u0bc0 \u0bae\u0bbf \u0bae\u0bbe \u0bae\u0bcd \u0bae"
  },
  {
    "id": "word_021",
    "kind": "word",
    "text": "\u0baf\u0bcc \u0baf\u0bcb \u0baf\u0bca \u0baf\u0bc8 \u0baf\u0bc7 \u0baf\u0bc6 \u0baf\u0bc2 \u0baf\u0bc1 \u0baf\u0bc0 \u0baf\u0bbf \u0baf\u0bbe \u0baf\u0bcd \u0baf"
  },
  {
    "id": "word_022",
    "kind": "word",
    "text": "\u0bb0\u0bcc \u0bb0\u0bcb \u0bb0\u0bca \u0bb0\u0bc8 \u0bb0\u0bc7 \u0bb0\u0bc6 \u0bb0\u0bc1 \u0bb0\u0bc0 \u0bb0\u0bbf \u0bb0\u0bbe \u0bb0"
