{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tamil-toolkit golden vector",
  "type": "object",
  "required": ["id", "op", "input", "dialect", "tags", "source"],
  "oneOf": [{"required": ["expected"], "not": {"required": ["expected_error"]}}, {"required": ["expected_error"], "not": {"required": ["expected"]}}],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "op": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "input": {},
    "expected": {},
    "expected_error": {"type": "string", "minLength": 1},
    "dialect": {"enum": ["COMMON", "TN", "SL"]},
    "locale": {"enum": ["TN", "SL"]},
    "region": {"enum": ["TN", "JAFFNA", "BATTICALOA", "VANNI", "UP_COUNTRY", "KONGU", "CHENNAI"]},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {"type": "string", "minLength": 1},
    "unicode_exceptions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["path", "kind", "reason"], "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "pattern": "^/(input|expected)(/.*)?$"},
          "kind": {"enum": ["non_nfc", "joiner"]},
          "reason": {"type": "string", "minLength": 12}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"op": {"enum": ["get_letters", "normalize_nfc", "normalize_nfd", "split_uyirmei", "inspect_tamil_string", "sort_key", "search_key"]}}, "not": {"required": ["expected_error"]}},
      "then": {"properties": {"input": {"type": "string"}}}
    },
    {
      "if": {"properties": {"op": {"const": "get_letters"}}},
      "then": {"properties": {"expected": {"type": "array", "items": {"type": "string"}}}}
    },
    {
      "if": {"properties": {"op": {"enum": ["normalize_nfc", "normalize_nfd", "compose_uyirmei"]}}},
      "then": {"properties": {"expected": {"type": "string"}}}
    },
    {
      "if": {"properties": {"op": {"const": "split_uyirmei"}}},
      "then": {"properties": {"expected": {"$ref": "#/$defs/parts"}}}
    },
    {
      "if": {"properties": {"op": {"const": "compose_uyirmei"}}, "not": {"required": ["expected_error"]}},
      "then": {"properties": {"input": {"$ref": "#/$defs/parts"}}}
    },
    {
      "if": {"properties": {"op": {"enum": ["sort_key", "search_key"]}}},
      "then": {"properties": {"expected": {"type": "array", "minItems": 1, "prefixItems": [{"const": 1}], "items": {"type": "integer", "minimum": 0, "maximum": 1114111}}}}
    },
    {
      "if": {"properties": {"op": {"const": "compare"}}, "not": {"required": ["expected_error"]}},
      "then": {"properties": {"input": {"type": "object", "required": ["left", "right"], "additionalProperties": false, "properties": {"left": {"type": "string"}, "right": {"type": "string"}}}}}
    },
    {
      "if": {"properties": {"op": {"const": "compare"}}},
      "then": {"properties": {"expected": {"enum": [-1, 0, 1]}}}
    },
    {
      "if": {"properties": {"op": {"const": "sort_words"}}, "not": {"required": ["expected_error"]}},
      "then": {"properties": {"input": {"type": "array", "items": {"type": "string"}}}}
    },
    {
      "if": {"properties": {"op": {"const": "sort_words"}}},
      "then": {"properties": {"expected": {"type": "array", "items": {"type": "string"}}}}
    },
    {"if": {"properties": {"op": {"enum": ["to_words"]}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["value"], "additionalProperties": false, "properties": {"value": {"type": "integer", "minimum": -999999999, "maximum": 999999999}, "locale": {"enum": ["TN", "SL"]}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"enum": ["format_currency", "currency_to_words"]}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["amount_minor", "currency"], "additionalProperties": false, "properties": {"amount_minor": {"type": "integer", "minimum": -99999999999, "maximum": 99999999999}, "currency": {"enum": ["INR", "LKR"]}, "locale": {"enum": ["TN", "SL"]}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"const": "bamini_to_unicode"}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {"text": {"type": "string"}, "errors": {"enum": ["strict", "preserve"]}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"const": "unicode_to_bamini"}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {"text": {"type": "string"}}}, "expected": {"type": "string", "pattern": "^[\\x00-\\x7f]*$"}}}},
    {"if": {"properties": {"op": {"enum": ["unicode_to_tscii_bytes", "unicode_to_tab_bytes", "unicode_to_tam_bytes", "unicode_to_anjal_bytes"]}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {"text": {"type": "string"}}}, "expected": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}}}}},
    {"if": {"properties": {"op": {"enum": ["tscii_bytes_to_unicode", "tab_bytes_to_unicode", "tam_bytes_to_unicode", "anjal_bytes_to_unicode"]}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["bytes"], "additionalProperties": false, "properties": {"bytes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"enum": ["lt_tm_codes_to_unicode", "vanavil_codes_to_unicode"]}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["codes"], "additionalProperties": false, "properties": {"codes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 65535}}, "errors": {"enum": ["strict", "preserve"]}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"enum": ["lt_tm_text_to_unicode", "vanavil_text_to_unicode"]}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {"text": {"type": "string"}, "errors": {"enum": ["strict", "preserve"]}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"enum": ["unicode_to_lt_tm_codes", "unicode_to_vanavil_codes"]}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {"text": {"type": "string"}}}, "expected": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 65535}}}}},
    {"if": {"properties": {"op": {"enum": ["unicode_to_lt_tm_text", "unicode_to_vanavil_text"]}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {"text": {"type": "string"}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"const": "format_fraction"}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["numerator", "denominator"], "additionalProperties": false, "properties": {"numerator": {"type": "integer", "minimum": -999999999, "maximum": 999999999}, "denominator": {"type": "integer", "minimum": -999999999, "maximum": 999999999}, "digits": {"enum": ["latin", "tamil"]}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"const": "fraction_to_words"}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["numerator", "denominator"], "additionalProperties": false, "properties": {"numerator": {"type": "integer", "minimum": -999999999, "maximum": 999999999}, "denominator": {"type": "integer", "minimum": -999999999, "maximum": 999999999}, "locale": {"enum": ["TN", "SL"]}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"const": "fraction_symbol"}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["numerator", "denominator"], "additionalProperties": false, "properties": {"numerator": {"type": "integer", "minimum": -999999999, "maximum": 999999999}, "denominator": {"type": "integer", "minimum": -999999999, "maximum": 999999999}}}, "expected": {"type": "string"}}}},
    {"if": {"properties": {"op": {"const": "format_date"}}, "not": {"required": ["expected_error"]}}, "then": {"properties": {"input": {"type": "object", "required": ["year", "month", "day"], "additionalProperties": false, "properties": {"year": {"type": "integer", "minimum": 1, "maximum": 9999}, "month": {"type": "integer", "minimum": 1, "maximum": 12}, "day": {"type": "integer", "minimum": 1, "maximum": 31}, "locale": {"enum": ["TN", "SL"]}, "style": {"enum": ["short", "medium", "long", "full"]}, "digits": {"enum": ["latin", "tamil"]}}}, "expected": {"type": "string"}}}}
  ],
  "$defs": {
    "parts": {
      "type": "object", "required": ["mei", "uyir"], "additionalProperties": false,
      "properties": {"mei": {"type": "string", "minLength": 1}, "uyir": {"type": "string", "minLength": 1}}
    }
  }
}
