# Reference digests cover upstream bytes; disable checkout newline conversion.
tests/reference/unicode-17.0.0/* -text
tests/reference/collate-v0.1/ta.xml -text
tests/reference/numerals-v0.1/* -text
tests/reference/numerals-v0.2/* -text
tests/reference/codec-v0.1/* -text
tests/reference/codec-tscii/* -text
tests/reference/lexicon/structural/sample_source/* -text
/data/sources/tamil-lexicon/* -text
/data/sources/tamil-lexicon.sha256.json -text

# Lexicon table codecs require identical UTF-8 bytes and LF across platforms.
/data/curation/tamil-lexicon/*.csv text eol=lf
/lexicon/dictionary/*.csv text eol=lf
/lexicon/dictionary/*.toml text eol=lf
/lexicon/dictionary/*.md text eol=lf
/lexicon/dictionary/notices/*.md text eol=lf
/lexicon/packs/*/*.csv text eol=lf
/lexicon/packs/*/*.toml text eol=lf
/lexicon/packs/*/*.md text eol=lf
/lexicon/packs/*/notices/*.md text eol=lf
/schemas/lexicon/*.json text eol=lf
/schemas/lexicon/cldf/**/*.json text eol=lf
/data/sources/**/snapshots_manifest.json text eol=lf
/data/sources/**/notices/*.md text eol=lf

# Generated distribution copies must compare byte for byte on every platform.
/lexicon/*.toml text eol=lf
/crates/*/lexicon/*.toml text eol=lf
/crates/*/README.md text eol=lf
/README.md text eol=lf
/bindings/*/README.md text eol=lf
**/LICENSE text eol=lf
**/THIRD_PARTY_NOTICES.md text eol=lf
